# ============================================================
# LiteLLM Gateway Authentication & Encryption Secrets
# ============================================================

# Gateway authentication (single master key for all clients)
LITELLM_MASTER_KEY=CHANGE_ME

# Encryption salt key (used by LiteLLM to encrypt API keys in PostgreSQL)
LITELLM_SALT_KEY=CHANGE_ME

# LiteLLM Admin Web UI (http://localhost:4000/ui)
UI_USERNAME=admin
UI_PASSWORD=CHANGE_ME


# ============================================================
# PostgreSQL Container Credentials (Single DB)
# ============================================================

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME

# LiteLLM database connection string
DATABASE_URL=postgresql://litellm:CHANGE_ME@postgres:5432/litellm
